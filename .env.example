# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=icecream-intel
MODEL_FAST=groq:openai/gpt-oss-20b
MODEL_FAST_FALLBACK=google_genai:gemini-3.5-flash-lite
MODEL_SMART=google_genai:gemini-3.5-flash
MODEL_SMART_FALLBACK=groq:openai/gpt-oss-120b
GEMINI_RPM=5
GROQ_RPM=30
DATA_DIR=./data/store
MAX_QUESTION_CHARS=2000
